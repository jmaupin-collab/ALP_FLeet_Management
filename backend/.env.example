# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string

# Local SQLite (Phase 1–3 default)
DATABASE_URL=sqlite:///./fleet.db

# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/fleet_mgmt

# Explicit origins. A literal "*" is rejected when ENVIRONMENT=production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Creates demo accounts with well-known passwords. Off by default and refused
# outright when ENVIRONMENT=production. Only turn this on for a throwaway
# local database.
SEED_DEMO_DATA=false

# Comma-separated accounts that cannot be deleted, deactivated, or demoted.
PROTECTED_ADMIN_EMAILS=
