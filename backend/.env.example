# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string

# Local SQLite (Phase 1–3 default)
DATABASE_URL=sqlite:///./fleet.db

# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/fleet_mgmt

# Explicit origins. A literal "*" is rejected when ENVIRONMENT=production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Creates demo accounts with well-known passwords. Off by default and refused
# outright when ENVIRONMENT=production. Only turn this on for a throwaway
# local database.
SEED_DEMO_DATA=false

# Comma-separated accounts that cannot be deleted, deactivated, or demoted.
PROTECTED_ADMIN_EMAILS=

# --- Public ALPR request form ------------------------------------------------

# Which tenant owns requests submitted by anonymous visitors. Optional only when
# exactly one active internal organization exists; with more than one, intake is
# refused rather than guessed at, because misrouting would leak a customer's
# request into the wrong tenant.
PUBLIC_REQUEST_ORG_SLUG=

# Submissions allowed per client IP per window. Set the limit to 0 to disable.
PUBLIC_REQUEST_RATE_LIMIT=5
PUBLIC_REQUEST_RATE_WINDOW_SECONDS=3600

# CAPTCHA on the public form. "none" (default) skips verification entirely;
# "turnstile" or "recaptcha" require the keys below. The site key is public by
# design, the secret key never leaves the server. If the provider is unreachable
# the submission is refused — it is a gate, not a courtesy.
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
# Defaults to Cloudflare Turnstile's siteverify endpoint.
CAPTCHA_VERIFY_URL=

# --- Notification delivery ---------------------------------------------------

# Email for new-request alerts. "none" (default) logs instead of sending; a
# misconfigured or unreachable provider never fails the submission it is
# announcing.
EMAIL_PROVIDER=none
EMAIL_FROM=
EMAIL_API_KEY=
EMAIL_API_URL=
# Optional shared mailbox. When set it replaces the per-user recipient list, so
# alerts can go somewhere that has no Fleet Command account.
EMAIL_NOTIFY_RECIPIENTS=

# Web Push, so a new request reaches a browser whose tab is closed. Generate a
# key pair with: python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print(v.public_key, v.private_key)"
# Without both keys push is skipped and in-app notifications still work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:fleet@example.com

# Telematics ingest. Any provider (Geotab, a Cube tracker, a script) POSTs to
# /telematics/locations with this key in an X-API-Key header. Leave it blank and
# the endpoint refuses every call rather than accepting anonymous position
# writes. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Tracking is opt-in per asset. GET /telematics/tracked-devices returns the only
# device ids a poller should ask the provider about, and positions for anything
# else are discarded on arrival, so a provider account holding hundreds of
# vehicles never turns into hundreds of tracked assets here.
TELEMATICS_API_KEY=
# How close a unit must be for a site to count as arrived. Override per site
# from the warehouse or agency record when a yard is much bigger or smaller.
GEOFENCE_RADIUS_METERS=250
# Arriving at a warehouse checks the unit in automatically. Set false to get the
# alerts without the status change.
GEOFENCE_AUTO_CHECKIN=true
